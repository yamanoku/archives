{
  "name": "archives.yamanoku.net",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "generateOgImage": "node tools/ogp/generateOgImage.mjs",
    "test": "node --test --experimental-test-snapshots src/**/*.test.ts",
    "test:ogp": "node --test --experimental-test-snapshots tools/ogp/**/*.test.mjs",
    "test:update": "node --test --experimental-test-snapshots --test-update-snapshots tools/ogp/**/*.test.mjs",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@ox-content/vite-plugin": "^3.2.8",
    "modern-normalize": "3.0.1",
    "temporal-polyfill-lite": "^1.0.0",
    "yama-normalize": "2.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "budoux": "0.9.3",
    "gray-matter": "4.0.3",
    "prettier": "3.10.1",
    "puppeteer": "25.18.1",
    "tsrs": "^7.1.0-beta.tsrs3",
    "vite": "^8.0.0"
  },
  "allowScripts": {
    "puppeteer@25.16.0": true
  }
}
